BOT_TOKEN=1234567890:replace_me
POSTGRES_DB=reminder_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/reminder_bot
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow
BOT_MODE=polling
POLLING_ALLOWED_UPDATES=message,edited_message,callback_query
APP_HOST=0.0.0.0
APP_PORT=8080
READINESS_TIMEOUT_SECONDS=2
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=change_me_to_random_long_secret
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_DURATION_SECONDS=60
WORKER_SEND_TIMEOUT_SECONDS=30
WORKER_LEASE_SAFETY_MARGIN_SECONDS=10
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=300
WORKER_MAX_ATTEMPTS=3

ADMIN_IDS=
