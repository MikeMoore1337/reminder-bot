BOT_TOKEN=1234567890:replace_me
POSTGRES_DB=reminder_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/reminder_bot
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow
BOT_MODE=polling
POLLING_ALLOWED_UPDATES=message,edited_message,callback_query
APP_HOST=0.0.0.0
APP_PORT=8080
APP_PUBLISH_HOST=0.0.0.0
READINESS_TIMEOUT_SECONDS=2
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=change_me_to_random_long_secret
WORKER_BATCH_SIZE=100
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_DURATION_SECONDS=60
WORKER_SEND_TIMEOUT_SECONDS=30
WORKER_LEASE_SAFETY_MARGIN_SECONDS=10
WORKER_RETRY_BASE_SECONDS=10
WORKER_RETRY_MAX_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# Bounded important/persistent reminder policy
PERSISTENT_REPEAT_INTERVAL_MINUTES=60
PERSISTENT_MAX_DELIVERIES=6
PERSISTENT_MAX_ESCALATIONS=5
PERSISTENT_QUIET_HOURS_START=22:00
PERSISTENT_QUIET_HOURS_END=08:00
PERSISTENT_USER_COOLDOWN_MINUTES=1

# Optional local voice reminders. The host runtime bundle is mounted read-only
# by Compose; keep binaries and models outside the repository.
VOICE_RUNTIME_DIR=/opt/reminder-bot/voice-runtime
VOICE_STT_COMMAND=/opt/reminder-bot/voice/bin/whisper-cli
VOICE_STT_MODEL_PATH=/opt/reminder-bot/voice/models/ggml-base.bin
VOICE_STT_LANGUAGE=ru
VOICE_STT_THREADS=2
VOICE_STT_TIMEOUT_SECONDS=90
VOICE_STT_MAX_CONCURRENT_JOBS=1
VOICE_STT_QUEUE_TIMEOUT_SECONDS=5
VOICE_CONVERSION_COMMAND=/opt/reminder-bot/voice/bin/ffmpeg
VOICE_CONVERSION_TIMEOUT_SECONDS=30
VOICE_DOWNLOAD_TIMEOUT_SECONDS=30
VOICE_TEMP_DIR=/var/lib/reminder-bot/voice-temp
VOICE_MAX_FILE_SIZE_BYTES=10000000
VOICE_MAX_DURATION_SECONDS=120
VOICE_DRAFT_TTL_SECONDS=900
VOICE_DRAFT_CLEANUP_INTERVAL_SECONDS=60

ADMIN_IDS=
